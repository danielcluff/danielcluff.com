---
interface Props {
  title: string;
  author: string;
  subtitle?: string;
  date?: string;
  preview?: boolean;
}

const { title, author, subtitle, date, preview = false } = Astro.props;
---

<section
  class:list={[
    'flex flex-col justify-center',
    preview ? 'min-h-full gap-4' : 'min-h-[70dvh] gap-10',
  ]}
>
  <div class="h-1.5 w-24 rounded-full bg-orange-600" aria-hidden="true"></div>

  <h1
    class:list={[
      'max-w-5xl leading-[1.05] font-semibold tracking-tight text-balance',
      preview ? 'text-4xl' : 'text-[clamp(3.5rem,6vw,5.5rem)]',
    ]}
  >
    {title}
  </h1>

  {
    subtitle ? (
      <p
        class:list={[
          'max-w-3xl leading-snug text-stone-600 text-pretty',
          preview ? 'text-lg' : 'text-[clamp(1.75rem,2.5vw,2.25rem)]',
        ]}
      >
        {subtitle}
      </p>
    ) : null
  }

  <div class:list={[
    'mt-4 flex flex-wrap items-baseline gap-x-6 gap-y-2 border-t border-stone-300',
    preview ? 'pt-4' : 'pt-8',
  ]}>
    <p class:list={['font-medium text-stone-900', preview ? 'text-base' : 'text-[clamp(1.5rem,2.1vw,2rem)]']}>
      {author}
    </p>
    {date ? (
      <p class:list={['text-stone-500', preview ? 'text-sm' : 'text-[clamp(1.125rem,1.5vw,1.375rem)]']}>
        {date}
      </p>
    ) : null}
  </div>
</section>

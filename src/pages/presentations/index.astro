---
import Layout from "../../layouts/Layout.astro";
import PresentationHeader from "../../components/PresentationHeader.astro";
import PresentationFooter from "../../components/PresentationFooter.astro";
import { presentations } from "../../data/presentations";
import PresentationPreview from "../../components/presentations/hosting-at-home/PresentationPreview.astro";
---

<Layout title="Presentations | Daniel Cluff" bgColor="bg-zinc-950 text-white">
    <PresentationHeader />
    <main class="mx-auto max-w-6xl px-4 presentations-page md:px-6">
        <section class="intro">
            <p class="eyebrow accent">Selected talks</p>
            <h1>Presentations</h1>
            <p class="lede">
                Notes, experiments, and practical ideas in a format you can explore at your own
                pace.
            </p>
        </section>

        <section class="presentation-list" aria-label="Presentations">
            {
                presentations.map((presentation) => (
                    <a
                        class="presentation-card"
                        href={presentation.preview}
                        style={`--presentation-accent: ${presentation.accent}`}
                    >
                        <div
                            class="preview-shell"
                            transition:name={`presentation-${presentation.slug}`}
                        >
                            <PresentationPreview />
                            <span class="open-label">
                                Open deck <span aria-hidden="true">↗</span>
                            </span>
                        </div>
                        <div class="presentation-copy">
                            <p class="presentation-number">01 / presentation</p>
                            <h2>{presentation.title}</h2>
                            <p>{presentation.description}</p>
                            <p class="details">{presentation.details}</p>
                        </div>
                    </a>
                ))
            }
        </section>
    </main>
    <PresentationFooter />
</Layout>

<style>
    .presentations-page {
        padding-block: 5rem 7rem;
    }

    .intro {
        max-width: 42rem;
        margin-bottom: 5rem;
    }

    .eyebrow,
    .presentation-number {
        margin: 0 0 1rem;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    h1 {
        margin-bottom: 1rem;
        font-size: clamp(3rem, 8vw, 6rem);
        letter-spacing: -0.07em;
    }

    .lede {
        max-width: 34rem;
        margin: 0;
        color: #b5bac5;
        font-size: clamp(1.1rem, 2vw, 1.35rem);
    }

    .presentation-list {
        display: grid;
        gap: 5rem;
    }

    .presentation-card {
        display: grid;
        gap: 2rem;
        color: inherit;
        text-decoration: none;
    }

    @media (min-width: 768px) {
        .presentation-card {
            grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.65fr);
            align-items: center;
            gap: 4rem;
        }
    }

    .preview-shell {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--presentation-accent) 45%, transparent);
        background: #f5f5f4;
        box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.2);
        transition:
            transform 350ms ease,
            box-shadow 350ms ease;
    }

    @media (min-width: 768px) {
        .preview-shell {
            width: 92%;
        }
    }

    .presentation-card:hover .preview-shell,
    .presentation-card:focus-visible .preview-shell {
        transform: translateY(-0.5rem) rotate(-0.5deg);
        box-shadow: 0 2rem 5rem rgb(0 0 0 / 0.3);
    }

    .open-label {
        position: absolute;
        right: 1rem;
        bottom: 1rem;
        padding: 0.5rem 0.75rem;
        color: white;
        background: rgb(0 0 0 / 0.7);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        opacity: 0;
        transform: translateY(0.5rem);
        transition:
            opacity 200ms ease,
            transform 200ms ease;
    }

    .presentation-card:hover .open-label,
    .presentation-card:focus-visible .open-label {
        opacity: 1;
        transform: translateY(0);
    }

    .presentation-copy {
        min-width: 0;
    }

    .presentation-number {
        color: var(--presentation-accent);
    }

    h2 {
        margin: 0;
        font-size: clamp(1.75rem, 4vw, 3rem);
        letter-spacing: -0.05em;
    }

    .presentation-copy > p:not(.presentation-number) {
        max-width: 38rem;
        margin: 0.75rem 0 0;
        color: #d5d8de;
    }

    .presentation-copy .details {
        color: #9299a6;
        font-size: 0.95rem;
    }

    @media (max-width: 700px) {
        .presentations-page {
            padding-block: 3rem 5rem;
        }

        .intro {
            margin-bottom: 3rem;
        }

        .presentation-list {
            gap: 4rem;
        }

        .presentation-copy {
            display: block;
        }

        .presentation-number {
            margin-bottom: 0.75rem;
        }
    }
</style>
